# Application
NODE_ENV=development
PORT=4001
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://nexus_user:nexus_secret@localhost:5432/nexus_identity?schema=public&sslmode=prefer"

# Redis Cache & Sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Cryptographic Keys (RS256 PEM format)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n[GENERATE_WITH_OPENSSL_OR_VAULT]\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n[GENERATE_WITH_OPENSSL_OR_VAULT]\n-----END PUBLIC KEY-----"

# Token Expiry Durations
JWT_ACCESS_EXPIRY=900s
JWT_REFRESH_EXPIRY=604800s
