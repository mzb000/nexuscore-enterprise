# Order Service Configuration
PORT=50051
ENVIRONMENT=development

# PostgreSQL Database
DATABASE_URL=postgres://nexus_user:nexus_secret@localhost:5432/nexus_orders?sslmode=disable

# Redis Cluster / Standalone (Redlock distributed locking)
REDIS_ADDRS=localhost:6379
REDIS_PASSWORD=

# Kafka Broker Endpoints
KAFKA_BROKERS=localhost:9092
KAFKA_ORDER_EVENTS_TOPIC=nexus.order.events
KAFKA_ORDER_COMMANDS_TOPIC=nexus.order.commands
KAFKA_CONSUMER_GROUP=nexus-order-service-group

# Worker Pool Concurrency Settings
WORKER_POOL_SIZE=20
WORKER_QUEUE_CAPACITY=1000
