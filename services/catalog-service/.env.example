# Application Settings
ENVIRONMENT=development
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# MongoDB NoSQL Catalog Store
MONGODB_URI=mongodb://nexus_user:nexus_secret@localhost:27017/nexus_catalog?authSource=admin
MONGODB_DB_NAME=nexus_catalog
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Elasticsearch 8.x Distributed Search Engine
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=nexus_products_v1
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
